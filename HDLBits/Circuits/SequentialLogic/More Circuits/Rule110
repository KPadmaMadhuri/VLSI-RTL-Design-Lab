module top_module(
    input clk,
    input load,
    input [511:0] data,
    output [511:0] q ); 
    
    integer i;
    reg [511:0]n;
    always@(posedge clk) begin
        if(load) begin
            n <= data;
        end else begin
            for(i=510; i>0; i=i-1) begin
                n[i] <= ((~n[i+1]) & n[i-1])|(n[i]^n[i-1]);
            end
            n[511] <= n[510] | (n[511]^n[510]);
            n[0] <= n[0];
        end
    end
    assign q = n;                

endmodule

